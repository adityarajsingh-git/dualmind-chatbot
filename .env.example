# Optional — enables saving support tickets to MongoDB Atlas.
#
# Copy this file to `.env` (gitignored) and paste your Atlas connection string.
#   • Local:   `npm run dev` will then save tickets via the dev middleware.
#   • Vercel:  set MONGODB_URI in Project → Settings → Environment Variables
#              (do NOT commit it).
#
# Leave it unset to run fully client-side (tickets just show locally).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
